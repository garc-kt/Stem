# Copy this file to keystore.properties (repo root, gitignored) and fill in your
# real release keystore details. Never commit keystore.properties or the .jks/.keystore
# file itself. In CI, set the same names as environment variables instead of a file.
RELEASE_STORE_FILE=/absolute/path/to/sprout-release.jks
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=sprout
RELEASE_KEY_PASSWORD=changeme
