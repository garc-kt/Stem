<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules. See backup_rules.xml for why the preferences DataStore
  (which holds API credentials) is excluded from both cloud backup and device-to-device
  transfer rather than restored.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sprout_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sprout_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
