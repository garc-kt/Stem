<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Settings tile icon: must be a simple single-color shape (fillColor is ignored by
     the system, which re-tints it per tile state) rather than the full-color adaptive
     launcher icon, or it won't follow the system's dynamic Monet tile colors. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,2 C18,6 18,18 12,22 C6,18 6,6 12,2 Z" />
</vector>
